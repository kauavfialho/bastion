<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Bastion</AssemblyName>
    <RootNamespace>Bastion</RootNamespace>
    <Product>Bastion</Product>
    <Version>1.0.0</Version>
    <!-- O launcher lê a versão do .exe: precisa ser só "1.0.0", sem o código do commit no fim -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Kauã Fialho</Company>
    <Copyright>© 2026 Kauã Fialho · MIT</Copyright>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Teste de disco usa memória alinhada para ler/gravar sem o cache do Windows -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-256.png" />
  </ItemGroup>

  <!-- Publicação: um único .exe que roda em qualquer Windows 10/11 x64 sem instalar nada -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
